# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: email notifications (Resend) — set up when you're ready
# RESEND_API_KEY=re_...
# CONTACT_NOTIFY_EMAIL=samad@example.com

# Optional: WhatsApp webhook (Interakt / Zapier) for admin alerts on form submits
# WHATSAPP_ADMIN_WEBHOOK_URL=
